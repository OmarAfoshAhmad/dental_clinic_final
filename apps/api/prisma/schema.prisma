generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  FEMALE
  MALE
}

enum QueueStatus {
  WAITING
  WITH_DOCTOR
  IN_CLINIC
  TREASURY
}

model Clinic {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  doctors   Doctor[]
  patients  Patient[]
  queue     QueueEntry[]
  createdAt DateTime     @default(now())
}

model Doctor {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  clinicId  String
  clinic    Clinic       @relation(fields: [clinicId], references: [id])
  patients  Patient[]
  queue     QueueEntry[]
  createdAt DateTime     @default(now())
}

model Patient {
  id             String       @id @default(cuid())
  fileNumber     Int          @unique @default(autoincrement())
  fullName       String
  birthDate      DateTime?
  gender         Gender
  phone          String
  secondaryPhone String?
  address        String?
  clinicId       String?
  doctorId       String?
  clinic         Clinic?      @relation(fields: [clinicId], references: [id])
  doctor         Doctor?      @relation(fields: [doctorId], references: [id])
  queueEntries   QueueEntry[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([fullName])
  @@index([phone])
}

model QueueEntry {
  id        String      @id @default(cuid())
  patientId String
  clinicId  String?
  doctorId  String?
  status    QueueStatus @default(WAITING)
  arrivedAt DateTime    @default(now())
  patient   Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic    Clinic?     @relation(fields: [clinicId], references: [id])
  doctor    Doctor?     @relation(fields: [doctorId], references: [id])

  @@index([status, arrivedAt])
}
